{
  "type": "module",
  "name": "playwrightpracticeproject",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "orangeHRM": "playwright test --config=playwright.config.js src/JavaScript/Web/tests/BasicUiTestValidation.spec.js",
    "test:RegistrationForm": "cucumber-js --config cucumber.config.js --profile RegistrationForm",
    "test:OrangeHRM": "cucumber-js --config cucumber.config.js --profile OrangeHRM",
    "test:js": "playwright test --config=playwright.config.js",
    "test:ts": "playwright test --config=playwright.config.ts",
    "test": "npm run test:js && npm run test:ts",
    "debug": "cross-env PWDEBUG=1 cucumber-js --config cucumber.config.js --profile OrangeHRM",
    "serenity:report": "npx serenity-js run",
    "serenity:open": "npx serenity-js serve",
    "API:Test": "cucumber-js --config cucumber.config.js --profile API"
  },
  "author": "Ratnakar Kolhatkar",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.0.9",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "expect": "^30.2.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "mysql2": "^3.17.2"
  }
}
